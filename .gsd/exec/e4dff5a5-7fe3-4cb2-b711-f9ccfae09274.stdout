FORBIDDEN_MATCHES=['release-ready']

COMMAND=python3 - <<'PY'
from pathlib import Path
p = Path('.gsd/milestones/M001/slices/S06/S06-HUMAN-UAT-GATE.md')
text = p.read_text()
forbidden = [
    'Gate status: approved',
    'Human UAT: approved',
    'Validation posture: pass',
    'release-ready',
    'Release readiness: ready',
    ': completed',
    ': human-deferred',
]
found = [item for item in forbidden if item in text]
required = [
    'Gate status: unresolved/escalated',
    'Human UAT: not approved.',
    ': not completed and not human-deferred.',
    'Validation posture: needs-attention.',
    'Human source: none available in this autonomous execution context.',
]
missing = [item for item in required if item not in text]
if found or missing:
    if found:
        print('FORBIDDEN_MATCHES=' + repr(found))
    if missing:
        print('MISSING_REQUIRED=' + repr(missing))
    raise SystemExit(1)
print('negative gate checks passed: no affirmative approval, no pass posture, no release-ready posture')
PY
EXIT_CODE=1
DURATION_MS=42
